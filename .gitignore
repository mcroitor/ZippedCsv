# ignore common
.vscode/
# exclude zipped csv
*.csv.zip
*.zcsv
# keep cross-language test fixtures
!python/tests/fixtures/*.zcsv
!js/editor/tests/fixtures/*.zcsv
# skip downloadable packages and intermediate files
## JS / TS
node_modules/
## Python
__pycache__/
*.pyc
*.pyo
## C / C++
*.o
*.obj
*.so
*.dll
*.dylib
*.exe
build/
## Java
*.class